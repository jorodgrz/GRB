# Local copy of the Levina et al. Fit_SFRD_TNG files (tables also live in data/)
TNG_S(Z,z)/

# Data products (COMPAS HDF5 files, TNG tables; nothing in data/ is tracked)
data/*

# Download cache for tools/download_compas_data.py (Zenodo zips and
# parsed manifests).  Already covered by data/* above, but called out
# explicitly so it is obvious where partial downloads live.
data/_cache/

# Local research notes (LLM council transcripts, literature synthesis)
council/

# Matplotlib font cache
.mpl-cache/

# Pytest run cache
.pytest_cache/

# mypy / ruff caches (also self-ignored by nested .gitignore inside each
# cache dir, but listed here so a fresh cache or a force-add cannot leak)
.mypy_cache/
.ruff_cache/

# Local PDF-extraction virtualenv
.venv_pdf/

# Smoke-test marker written by tests/test_grb_main_notebook.py
plots/.smoke_marker

# Section 6d / 7c per-class R(z) grid caches.  Unlike the Section 11 and
# 6c caches these are not tracked: nothing else reads them, and the cells
# rebuild them from data/ in about four minutes each when absent.
plots/rate_bns_by_class_per_model.npz
plots/rate_bhns_by_class_per_model.npz

# Coverage.py / pytest-cov outputs
.coverage
.coverage.*
htmlcov/
coverage.xml

# Notebook-run cache/logs (nbrun execution artifacts)
.nbrun/

# Stray scratch file
zisHCU3D
.cursor/
